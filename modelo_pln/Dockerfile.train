# Usar una imagen base con las herramientas necesarias
FROM python:3.9-slim

# Crear usuario no root
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && mkdir -p /app /app/logs /app/data/{models,plots,raw} \
    && chown -R appuser:appuser /app

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Configurar el directorio de trabajo
WORKDIR /app

# Copiar requirements e instalar dependencias
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Descargar recursos de NLTK
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('stopwords'); nltk.download('wordnet')"

# Crear directorios necesarios
RUN mkdir -p /app/data/{models,plots,raw} \
    && mkdir -p /home/appuser/nltk_data \
    && chmod -R 755 /app/data \
    && chown -R appuser:appuser /app/data \
    && chown -R appuser:appuser /home/appuser

# Copiar código fuente
COPY src/ src/

# Asegurar permisos
RUN chmod -R 755 /app \
    && chown -R appuser:appuser /app

# Cambiar a usuario no root
USER appuser

# Establecer variables de entorno para NLTK y Matplotlib
ENV PYTHONPATH=/app/src:$PYTHONPATH \
    NLTK_DATA=/home/appuser/nltk_data \
    MPLCONFIGDIR=/tmp/matplotlib

# Verificar que se pueden importar los módulos principales
RUN python -c "from models.train_model import main; print('Training module loaded successfully')"

# Health check (simple check that Python works)
HEALTHCHECK --interval=5m --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Comando por defecto
CMD ["python", "src/models/train_model.py"]