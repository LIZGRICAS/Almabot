# ===================================
# AlbaBot - Configuración de Entorno
# ===================================
# Copia este archivo a .env y ajusta los valores según sea necesario

# ===== Configuración de la Base de Datos =====
# Credenciales de MySQL
DB_USER=almabot
DB_PASSWORD=almabot123
DB_ROOT_PASSWORD=almabot_root
DB_NAME=almabot
DB_PORT=3306
DB_HOST=db

# ===== Configuración de la API =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_WORKERS=4
API_RELOAD=False  # Solo para desarrollo

# ===== Configuración del Bot de Telegram =====
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ===== Configuración del Modelo =====
MODEL_PATH=/app/data/models/bullying_detection_model.joblib
VECTORIZER_PATH=/app/data/models/vectorizer.joblib

# ===== Configuración de Ollama (LLM) =====
OLLAMA_HOST=ollama_8001  # Nombre del servicio en docker-compose o localhost para desarrollo local
OLLAMA_PORT=11434        # Puerto por defecto de Ollama
OLLAMA_MODEL=mistral:7b-instruct  # Modelo a utilizar (mistral:7b-instruct, llama2, etc.)

# ===== Configuración de Entrenamiento =====
TRAINING_DATA_PATH=/app/data/raw/training_data.csv
TEST_DATA_PATH=/app/data/raw/test_data.csv
MODEL_SAVE_PATH=/app/data/models/

# ===== Configuración de Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/almabot.log

# ===== Configuración de Seguridad =====
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# ===== Configuración de la Aplicación =====
APP_ENV=production  # Puede ser 'development', 'staging' o 'production'
APP_DEBUG=False
APP_NAME=AlmaBot
APP_DESCRIPTION="Asistente virtual de diagnóstico y apoyo para víctimas de acoso escolar"
APP_VERSION=1.0.0

# ===== Configuración de CORS =====
CORS_ORIGINS=["http://localhost:3000", "https://tudominio.com"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_HEADERS=["Content-Type", "Authorization"]

# ===== Configuración de Límites de Tasa =====
RATE_LIMIT=100/1minute

# ===== Configuración de Correo Electrónico (Opcional) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_USE_TLS=True
EMAIL_FROM=no-reply@almabot.org

# ===== Configuración de Monitoreo (Opcional) =====
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# ===== Variables Específicas del Entorno =====
# Sobrescribe las configuraciones anteriores según el entorno
# Ejemplo para desarrollo local:
# APP_ENV=development
# APP_DEBUG=True
# API_RELOAD=True
# LOG_LEVEL=DEBUG