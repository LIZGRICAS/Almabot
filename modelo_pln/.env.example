# ===================================
# AlbaBot - Configuración de Entorno
# ===================================
# Copia este archivo a .env y ajusta los valores según sea necesario

# ===== Configuración de la Base de Datos =====
# Credenciales de MySQL
DB_USER=almabot
DB_PASSWORD=almabot123
DB_ROOT_PASSWORD=almabot_root
DB_NAME=almabot
DB_PORT=3306
DB_HOST=db

# ===== Configuración de la API =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_WORKERS=4
API_RELOAD=False  # Solo para desarrollo

# ===== Configuración del Bot de Telegram =====
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ===== Configuración del Modelo =====
MODEL_PATH=/app/data/models/bullying_detection_model.joblib
VECTORIZER_PATH=/app/data/models/vectorizer.joblib

# ===== Configuración de la API de LLM =====
# Tipo de API: openai, azure, together, etc.
LLM_API_TYPE=together
# Modelo a utilizar
LLM_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
# Clave de API
LLM_API_KEY=key
# URL base de la API
LLM_API_BASE=url

# ===== Configuración de Entrenamiento =====
TRAINING_DATA_PATH=/app/data/raw/training_data.csv
TEST_DATA_PATH=/app/data/raw/test_data.csv
MODEL_SAVE_PATH=/app/data/models/

# ===== Configuración de Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/almabot.log

# ===== Configuración de Seguridad =====
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# ===== Configuración de la Aplicación =====
APP_ENV=production  # Puede ser 'development', 'staging' o 'production'
APP_DEBUG=False
APP_NAME=AlmaBot
APP_DESCRIPTION="Asistente virtual de diagnóstico y apoyo para víctimas de acoso escolar"
APP_VERSION=1.0.0
